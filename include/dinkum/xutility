// The stock VC6 header plus _Ptrit, the class wrapper Dinkum uses for pointer iterators
// (vector::iterator). Proven by TCP: begin() returns through a hidden pointer (0x3364/0x3370),
// the converting ctor is out of line (0x3558), operator+ is out of line (0x3750).
#ifndef EE_DINKUM_XUTILITY
#define EE_DINKUM_XUTILITY
#include "../../toolkit/msvc6.0/Include/XUTILITY"

#ifdef  _MSC_VER
#pragma pack(push,8)
#endif  /* _MSC_VER */
_STD_BEGIN
		// TEMPLATE CLASS _Ptrit
template<class _Ty, class _D, class _Pt, class _Rt,
	class _Pt2, class _Rt2>
	class _Ptrit : public _Ranit<_Ty, _D> {
public:
	typedef _Ptrit<_Ty, _D, _Pt, _Rt, _Pt2, _Rt2> _Myt;
	typedef _Pt pointer;
	typedef _Rt reference;
	_Ptrit()
		{}
	explicit _Ptrit(_Pt _P)
		: current(_P) {}
	_Ptrit(const _Ptrit<_Ty, _D, _Pt2, _Rt2, _Pt2, _Rt2>& _X)
		: current(_X.base()) {}
	_Pt base() const
		{return (current); }
	_Rt operator*() const
		{return (*current); }
	_Pt operator->() const
		{return (&**this); }
	_Myt& operator++()
		{++current;
		return (*this); }
	_Myt operator++(int)
		{_Myt _Tmp = *this;
		++current;
		return (_Tmp); }
	_Myt& operator--()
		{--current;
		return (*this); }
	_Myt operator--(int)
		{_Myt _Tmp = *this;
		--current;
		return (_Tmp); }
	bool operator==(const _Myt& _X) const
		{return (current == _X.current); }
	bool operator!=(const _Myt& _X) const
		{return (!(*this == _X)); }
	_Myt& operator+=(_D _N)
		{current += _N;
		return (*this); }
	_Myt operator+(_D _N) const
		{return (_Myt(current + _N)); }
	_Myt& operator-=(_D _N)
		{current -= _N;
		return (*this); }
	_Myt operator-(_D _N) const
		{return (_Myt(current - _N)); }
	_Rt operator[](_D _N) const
		{return (*(*this + _N)); }
	bool operator<(const _Myt& _X) const
		{return (current < _X.current); }
	bool operator>(const _Myt& _X) const
		{return (_X < *this); }
	bool operator<=(const _Myt& _X) const
		{return (!(_X < *this)); }
	bool operator>=(const _Myt& _X) const
		{return (!(*this < _X)); }
	_D operator-(const _Myt& _X) const
		{return (current - _X.current); }
protected:
	_Pt current;
	};
_STD_END
#ifdef  _MSC_VER
#pragma pack(pop)
#endif  /* _MSC_VER */
#endif
