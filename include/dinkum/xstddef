// <xstddef> as seen through the Dinkum C++ Library 2.33. RECONSTRUCTION.
// The stock VC6 header, plus the library's exceptions-disabled macros when compiling without /GX (no
// _CPPUNWIND): _THROW constructs the exception and calls _Raise() (TCP 0x41f0 _Xlen -> 0x40e5 _Raise),
// _RAISE calls the imported std::_Throw, and the _TRY macros become plain blocks.
#ifndef EE_DINKUM_XSTDDEF
#define EE_DINKUM_XSTDDEF
#include "../../toolkit/msvc6.0/Include/XSTDDEF"
#if !defined(_CPPUNWIND) || defined(EE_DINKUM_SXL233)
 #undef _TRY_BEGIN
 #undef _CATCH
 #undef _CATCH_ALL
 #undef _CATCH_END
 #undef _RAISE
 #undef _RERAISE
 #undef _THROW0
 #undef _THROW1
 #undef _THROW
 #define _TRY_BEGIN	{
 #define _CATCH(x)	} if (0) {
 #define _CATCH_ALL	} if (0) {
 #define _CATCH_END	}
 #define _RAISE(x)	_Throw(x)
 #define _RERAISE
 #define _THROW0()
 #define _THROW1(x)
 #define _THROW(x, y)	x(y)._Raise()
#endif
#endif
